<template name="created-game-card">
<view class="match-card recent-match-card" data-id="{{item.id}}" data-status="{{item.status}}" bindtap="openRecord">
        <view class="summary-head"><view class="summary-tag">{{item.gameType}}</view><view class="badge">{{item.stateLabel}}</view></view>
        <view class="event-venue"><view class="event-venue-copy"><view class="venue-label-row"><text class="event-label">球房</text><view wx:if="{{item.distanceLabel}}" class="distance-entry" catchtap="openVenue" data-match="{{item}}"><view class="pin-icon"><view class="pin-dot"></view></view><text>{{item.distanceLabel}}</text></view><view wx:elif="{{!hasUserLocation}}" class="distance-entry" catchtap="chooseLocation"><view class="pin-icon"><view class="pin-dot"></view></view><text>选择位置查看距离 ›</text></view></view><view class="event-venue-name">{{item.venueName || '球房待选择'}}</view></view></view>
        <view class="event-time-row"><view class="event-clock">◷</view><view><view class="event-label">开球时间</view><view class="event-time-value">{{item.startLabel}}</view></view></view>
        <view class="summary-meta">费用 {{item.feeLabel}}</view>
        <view wx:if="{{item.level}}" class="summary-extra">水平：{{item.level}}</view>
        <view wx:if="{{item.note}}" class="summary-extra">备注：{{item.note}}</view>
        <view wx:if="{{item.cancelReason === 'PARTICIPANT_DELETED'}}" class="match-ended-reason">对方账号已注销，本场组局已结束</view>
        <view class="match-action-row"><button class="primary-button match-action-button match-action-chat" catchtap="openMatchChats" data-id="{{item.id}}"><text class="match-action-label">{{item.displayEnded ? '查看聊天' : '进入聊天'}}</text><text wx:if="{{item.chatUnreadCount}}" class="match-action-unread">{{item.chatUnreadCount > 99 ? '99+' : item.chatUnreadCount}}</text></button><button wx:if="{{item.canCancel}}" class="manage match-action-button match-action-cancel" catchtap="cancelRecord" data-id="{{item.id}}">取消约球</button></view>
      </view>
</template>
<template name="chatted-game-card">
<view class="match-card chatted" bindtap="openRecord" data-id="{{item.id}}" data-status="{{item.status}}"><view class="summary-head"><view class="summary-tag">{{item.gameType}}</view><view class="badge">{{item.stateLabel}}</view></view><view class="partner-label">与 {{item.peerName || '球友'}} 聊天</view><view wx:if="{{item.cancelReason === 'PARTICIPANT_DELETED'}}" class="match-ended-reason">对方账号已注销，本场组局已结束</view><view class="event-venue"><view class="event-venue-copy"><view class="venue-label-row"><text class="event-label">球房</text><view wx:if="{{item.distanceLabel}}" class="distance-entry" catchtap="openVenue" data-match="{{item}}"><view class="pin-icon"><view class="pin-dot"></view></view><text>{{item.distanceLabel}}</text></view><view wx:elif="{{!hasUserLocation}}" class="distance-entry" catchtap="chooseLocation"><view class="pin-icon"><view class="pin-dot"></view></view><text>选择位置查看距离 ›</text></view></view><view class="venue-title-row"><view class="event-venue-name">{{item.venueName || '球房待选择'}}</view></view></view></view><view class="event-time-row"><view class="event-clock">◷</view><view><view class="event-label">开球时间</view><view class="event-time-value">{{item.startLabel}}</view></view></view><view class="match-bottom"><text>费用 {{item.feeLabel}}</text><view class="detail chat-link" catchtap="openConversation" data-id="{{item.conversationId}}">{{item.displayEnded ? '查看聊天' : '进入聊天'}}<view wx:if="{{item.unreadCount}}" class="action-unread-dot"></view> ›</view></view></view>
</template>
