.welcome-page{min-height:100vh;box-sizing:border-box;padding:76rpx 42rpx 54rpx;background:#f7f7f2;color:#173d32}
.welcome-brand{display:flex;align-items:center;gap:14rpx;color:#174b3c;font-size:28rpx;font-weight:800}
.welcome-brand image{width:58rpx;height:58rpx}
.welcome-eyebrow{margin-top:104rpx;color:#718b7f;font-size:22rpx;font-weight:750;letter-spacing:3rpx}
.welcome-title{margin-top:20rpx;font-size:58rpx;line-height:1.18;font-weight:850;letter-spacing:1rpx}
.welcome-copy{margin-top:20rpx;color:#718178;font-size:25rpx;line-height:1.55}
.welcome-benefits{margin-top:52rpx;padding:8rpx 24rpx;border:1rpx solid #dfe7dc;border-radius:24rpx;background:#fffefa}
.benefit-row{display:flex;align-items:center;gap:18rpx;min-height:112rpx;border-bottom:1rpx solid #edf0e9;color:#214b3d;font-size:23rpx;font-weight:700}
.benefit-row:last-child{border-bottom:0}
.benefit-icon{width:48rpx;height:48rpx;display:flex;align-items:center;justify-content:center;border-radius:14rpx;background:#e8f1e8;color:#197257;font-size:29rpx}
.benefit-desc{display:block;margin-top:6rpx;color:#819188;font-size:19rpx;font-weight:400}
.welcome-login,.welcome-browse{display:flex;align-items:center;justify-content:center;box-sizing:border-box;width:100%;height:80rpx;min-height:80rpx;padding:0;margin:26rpx 0 0;border-radius:17rpx;font-size:25rpx;font-weight:700;line-height:1.2;text-align:center}
.welcome-login{background:#197257;color:#fff}
.welcome-browse{margin-top:14rpx;border:1rpx solid #bfcfc4;background:#fffefa;color:#197257}
.welcome-legal{margin-top:18rpx;text-align:center;color:#197257;font-size:19rpx}
