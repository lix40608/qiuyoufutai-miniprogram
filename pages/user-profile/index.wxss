.user-profile-page { padding-top: 34rpx; }
.profile-hero { display: flex; align-items: center; gap: 24rpx; padding: 30rpx; }
.profile-avatar { width: 132rpx; height: 132rpx; flex: none; display: flex; align-items: center; justify-content: center; overflow: hidden; border: 3rpx solid #dfe5da; border-radius: 50%; background: #eef1eb; }
.profile-avatar-image { width: 100%; height: 100%; }
.eight-ball { width: 110rpx; height: 110rpx; display: flex; align-items: center; justify-content: center; border: 5rpx solid #393d3b; border-radius: 50%; background: radial-gradient(circle at 32% 24%, #686d69 0, #222523 30%, #080909 72%); box-shadow: inset -8rpx -11rpx 18rpx rgba(0,0,0,.45), inset 5rpx 7rpx 10rpx rgba(255,255,255,.12); }
.eight-ball text { width: 48rpx; height: 48rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #f5f5f2; color: #111; font-size: 32rpx; font-weight: 800; }
.profile-identity { min-width: 0; }
.profile-nickname { color: #173128; font-size: 36rpx; font-weight: 800; }
.profile-meta { margin-top: 8rpx; }
.profile-section { margin-top: 34rpx; }
.section-title { margin: 0 4rpx 10rpx; color: #173128; font-size: 28rpx; font-weight: 800; }
.profile-intro { color: #43584d; font-size: 26rpx; line-height: 1.6; white-space: pre-wrap; }
.game-list { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 14rpx; }
.game-chip { padding: 12rpx 18rpx; border-radius: 24rpx; background: #e8efe5; color: #197257; font-size: 23rpx; }
