<view class="page find-page">
  <view class="find-heading row">
    <view>
      <view class="page-title">附近约球</view>
      <view class="location-entry" bindtap="showLocation">
        <view class="pin-icon location-pin"><view class="pin-dot"></view></view>
        <text class="location-entry-label">{{locationLabel}}</text>
        <text class="location-entry-arrow">›</text>

      </view>
      <view class="location-privacy">用于查找附近约局</view>
    </view>
    <view class="message-entry" bindtap="showMessages">消息</view>
  </view>

  <view class="search-box">
    <input class="search-input" placeholder="搜索球房或区域" value="{{searchText}}" bindinput="onSearchInput" />
    <text class="clear-search" bindtap="clearSearch">×</text>
  </view>

  <scroll-view class="chips-scroll" scroll-x="true" show-scrollbar="false">
    <view class="chips-row">
      <view wx:for="{{gameTypes}}" wx:key="*this" class="game-chip {{selectedGameType === item ? 'selected' : ''}}" data-type="{{item}}" bindtap="selectGameType">{{item}}</view>
    </view>
  </scroll-view>

  <view class="profile-filters">
    <picker mode="selector" range="{{ageFilterLabels}}" value="{{ageFilterIndex}}" bindchange="selectAgeFilter">
      <view class="filter-picker">{{ageFilterLabels[ageFilterIndex]}} <text>⌄</text></view>
    </picker>
    <picker mode="selector" range="{{genderFilters}}" value="{{genderFilterIndex}}" bindchange="selectGenderFilter">
      <view class="filter-picker">{{genderFilters[genderFilterIndex]}} <text>⌄</text></view>
    </picker>
  </view>

  <view class="section-heading row">
    <view class="section-title">附近约局</view>
    <view class="muted">{{matches.length}} 场招募中</view>
  </view>

  <view wx:if="{{matches.length}}">
    <view wx:for="{{matches}}" wx:key="id" class="match-card" data-id="{{item.id}}" bindtap="openMatch">
      <view class="row card-header"><view class="tag">{{item.gameType}}</view><view><text wx:if="{{currentUserId != null && item.hostUserId != null && currentUserId == item.hostUserId}}" class="own-match">我发起的</text><text wx:if="{{item.feeLabel}}" class="fee">费用 {{item.feeLabel}}</text></view></view>
      <view class="event-venue"><view class="event-venue-copy"><view class="venue-label-row"><text class="event-label">球房</text><view wx:if="{{item.distanceLabel}}" class="distance-entry" catchtap="openVenue" data-match="{{item}}"><view class="pin-icon"><view class="pin-dot"></view></view><text>{{item.distanceLabel}}</text></view><view wx:elif="{{!userLocation}}" class="distance-entry distance-prompt" catchtap="showLocation"><view class="pin-icon"><view class="pin-dot"></view></view><text>选择位置查看距离 ›</text></view></view><view class="venue-title-row"><view class="event-venue-name">{{item.venue || '球房待选择'}}</view></view></view></view>
      <view class="event-time-row"><view class="event-clock">◷</view><view class="event-time-copy"><view class="event-label">开球时间</view><view class="event-time-value">{{item.startLabel}}</view></view></view>
      <view wx:if="{{item.level}}" class="match-extra"><text class="extra-label">水平</text>{{item.level}}</view>
      <view wx:if="{{item.note}}" class="match-extra note-preview"><text class="extra-label">备注</text>{{item.note}}</view>
      <view wx:if="{{currentUserId == null || item.hostUserId == null || currentUserId != item.hostUserId}}" class="host-row" catchtap="openHostProfile" data-user-id="{{item.hostUserId}}">
        <view class="host-avatar">
          <image wx:if="{{item.hostAvatar}}" class="host-avatar-image" src="{{item.hostAvatar}}" mode="aspectFill" />
          <image wx:else class="eight-ball-image" src="/assets/eight-ball.png" mode="aspectFit" />
        </view>
        <view class="host-copy">
          <view class="host-primary"><text class="host-name">{{item.hostName}}</text><text wx:if="{{item.hostAge}}">{{item.hostAge}}岁</text><text wx:if="{{item.hostGender}}">{{item.hostGender}}</text></view>
          <view wx:if="{{item.hostIntro}}" class="muted host-intro">{{item.hostIntro}}</view>
        </view>
        <view class="profile-arrow">查看资料 ›</view>
      </view>
      <view wx:if="{{currentUserId != null && item.hostUserId != null && currentUserId != item.hostUserId}}" class="card-actions">
        <button class="primary-button action-button" catchtap="showDeferredFeature" data-id="{{item.id}}" data-focus="confirm">确认组局</button>
        <button class="primary-button secondary-button action-button" catchtap="showDeferredFeature" data-id="{{item.id}}" data-focus="chat">去聊聊</button>
      </view>
    </view>
  </view>
  <view wx:else class="empty-state">
    <view class="empty-title">{{loadError ? '暂时无法加载约球' : '暂时没有符合条件的约局'}}</view>
    <view class="muted">{{loadError || '试试切换玩法或搜索条件'}}</view>
  </view>
</view>
