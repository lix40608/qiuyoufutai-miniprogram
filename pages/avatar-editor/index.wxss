.avatar-editor-page { padding-top: 30rpx; padding-bottom: 64rpx; }
.avatar-stage { display: flex; align-items: center; justify-content: center; min-height: 400rpx; }
.avatar-preview { width: 260rpx; height: 260rpx; display: flex; align-items: center; justify-content: center; overflow: hidden; border: 8rpx solid #fffefa; border-radius: 50%; background: #eef1eb; box-shadow: 0 12rpx 36rpx rgba(32, 59, 46, .12); }
.avatar-image { width: 100%; height: 100%; }
.eight-ball { width: 246rpx; height: 246rpx; display: flex; align-items: center; justify-content: center; border: 6rpx solid #393d3b; border-radius: 50%; background: radial-gradient(circle at 32% 24%, #686d69 0, #222523 30%, #080909 72%); }
.eight-ball text { width: 102rpx; height: 102rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #f5f5f2; color: #111; font-size: 70rpx; font-weight: 800; }
.avatar-options { overflow: hidden; border: 1rpx solid #dfe5da; border-radius: 24rpx; background: #fffefa; }
.avatar-option { display: flex; align-items: center; justify-content: space-between; min-height: 92rpx; padding: 0 26rpx; border-bottom: 1rpx solid #edf0ea; color: #173128; font-size: 26rpx; }
.avatar-option:last-child { border-bottom: 0; }
.option-hover { background: #f1f6ef; }
.option-arrow { color: #98a69d; font-size: 38rpx; }
.avatar-note { margin-top: 18rpx; color: #8b968e; text-align: center; font-size: 21rpx; }
.confirm-button { margin-top: 26rpx; }

/* 用球面高光、暗部和柔和投影表现黑八的材质。 */
.eight-ball{box-sizing:border-box;border:1rpx solid #25292a;background:radial-gradient(ellipse at 28% 19%,rgba(255,255,255,.7) 0%,rgba(255,255,255,.24) 7%,rgba(255,255,255,0) 21%),radial-gradient(circle at 36% 28%,#505456 0%,#1e2223 40%,#080a0b 76%,#020303 100%);box-shadow:inset -5rpx -7rpx 12rpx rgba(0,0,0,.65),inset 2rpx 2rpx 5rpx rgba(255,255,255,.13),0 3rpx 7rpx rgba(0,0,0,.2)}
.eight-ball text{background:radial-gradient(circle at 35% 30%,#fff 0%,#e8e7df 72%,#b8bab4 100%);color:#171b1a;box-shadow:inset -2rpx -2rpx 4rpx rgba(0,0,0,.18)}

.avatar-preview .eight-ball-image{width:246rpx;height:246rpx}
