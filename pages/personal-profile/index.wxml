<view class="page profile-editor-page">
  <view id="personal-section" class="section-title">个人资料</view>
  <view class="profile-group">
    <view class="avatar-row" bindtap="openAvatarEditor" hover-class="row-hover">
      <view class="row-label">头像</view>
      <view class="avatar-preview">
        <image wx:if="{{pendingAvatarPath || personal.avatarPath}}" class="avatar-image" src="{{pendingAvatarPath || personal.avatarPath}}" mode="aspectFill" />
        <image wx:else class="eight-ball-image" src="/assets/eight-ball.png" mode="aspectFit" />
      </view>
      <text class="row-arrow">›</text>
    </view>
    <view class="field-row">
      <view class="row-label">昵称 <text class="required">*</text></view>
      <input class="row-input" maxlength="12" placeholder="填写昵称" value="{{personal.nickname}}" data-field="nickname" bindinput="onPersonalInput" />
    </view>
    <view wx:if="{{errors.nickname}}" class="field-error">{{errors.nickname}}</view>
    <view class="field-row">
      <view class="row-label">年龄 <text class="required">*</text></view>
      <input class="row-input" type="number" maxlength="3" placeholder="18周岁及以上" value="{{personal.age}}" data-field="age" bindinput="onPersonalInput" />
      <text wx:if="{{personal.age}}" class="row-unit">岁</text>
    </view>
    <view wx:if="{{errors.age}}" class="field-error">{{errors.age}}</view>
    <view class="field-row gender-row">
      <view class="row-label">性别 <text class="required">*</text></view>
      <view class="choice-row">
        <view wx:for="{{genderOptions}}" wx:key="*this" class="choice-chip {{personal.gender === item ? 'selected' : ''}}" data-value="{{item}}" bindtap="selectGender">{{item}}</view>
      </view>
    </view>
    <view wx:if="{{errors.gender}}" class="field-error">{{errors.gender}}</view>
  </view>
  <view class="section-title">约球联系方式</view>
  <view class="profile-group contact-profile-group">
    <view class="field-row">
      <view class="row-label">微信号 <text class="optional">选填</text></view>
      <input class="row-input" maxlength="20" placeholder="填写微信号" value="{{wechatId}}" adjust-position="false" cursor-spacing="24" bindinput="onWechatIdInput" />
    </view>
    <view class="contact-privacy-note">填写并保存后，双方确认组局时，本场对方可在详情查看并复制；不填写不影响站内聊天。</view>
  </view>
  <view id="archive-section" class="section-title">球员档案</view>
  <view class="profile-group archive-group">
    <view class="archive-label">常打玩法 <text class="optional">选填，可多选</text></view>
    <view class="choice-row game-options">
      <view wx:for="{{gameTypeOptions}}" wx:key="value" class="choice-chip {{item.selected ? 'selected' : ''}}" data-value="{{item.value}}" bindtap="toggleGameType">{{item.value}}</view>
    </view>
    <view class="archive-divider"></view>
    <view class="archive-label">台球自我介绍 <text class="optional">选填</text></view>
    <textarea class="intro-input" maxlength="120" placeholder="例如：下班后常打球，偏稳健打法" value="{{archive.intro}}" data-field="intro" bindinput="onArchiveInput" />
    <view class="intro-count">{{archive.intro.length || 0}}/120</view>
  </view>
  <view class="save-actions">
    <button class="primary-button secondary-button" bindtap="cancelEdit">取消</button>
    <button class="primary-button" bindtap="saveProfile">保存资料</button>
  </view>
</view>
