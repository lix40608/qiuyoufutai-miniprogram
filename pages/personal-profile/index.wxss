.profile-editor-page { padding-top: 34rpx; padding-bottom: 64rpx; }
.page-intro { margin-top: 10rpx; line-height: 1.5; }
.section-title { margin: 28rpx 4rpx 4rpx; font-size: 28rpx; font-weight: 800; }
.form-card { padding: 10rpx 24rpx 26rpx; }
.archive-form { margin-top: 14rpx; }
.field-title { margin: 24rpx 0 12rpx; font-size: 25rpx; font-weight: 700; }
.profile-input { box-sizing: border-box; width: 100%; height: 78rpx; padding: 0 18rpx; border: 1rpx solid #dfe5da; border-radius: 15rpx; background: #fff; color: #173128; font-size: 25rpx; line-height: 78rpx; }
.choice-row { display: flex; flex-wrap: wrap; gap: 14rpx; }
.choice-chip { padding: 13rpx 22rpx; border: 1rpx solid #dfe5da; border-radius: 28rpx; background: #f2f4ee; color: #52645b; font-size: 23rpx; }
.choice-chip.selected { border-color: #197257; background: #e4f0e7; color: #197257; font-weight: 700; }
.profile-action-button { flex: 1; height: 68rpx; margin: 0; padding: 0; border: 1rpx solid #b9d6c6; border-radius: 15rpx; background: #fffefa; color: #197257; font-size: 22rpx; line-height: 68rpx; }
.avatar-setting { display: flex; align-items: center; gap: 22rpx; }
.avatar-preview { width: 128rpx; height: 128rpx; flex: none; overflow: hidden; display: flex; align-items: center; justify-content: center; border: 4rpx solid #dfe5da; border-radius: 50%; background: #eef1eb; }
.avatar-image { width: 100%; height: 100%; }
.eight-ball { width: 108rpx; height: 108rpx; display: flex; align-items: center; justify-content: center; border: 4rpx solid #393d3b; border-radius: 50%; background: radial-gradient(circle at 32% 24%, #686d69 0, #222523 30%, #080909 72%); box-shadow: inset -8rpx -11rpx 18rpx rgba(0,0,0,.45), inset 5rpx 7rpx 10rpx rgba(255,255,255,.12); }
.eight-ball text { width: 46rpx; height: 46rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #f5f5f2; color: #111; font-size: 30rpx; font-weight: 800; }
.avatar-actions { flex: 1; }
.reset-avatar { margin: 12rpx 0 0; padding: 0; background: transparent; color: #718178; font-size: 22rpx; line-height: 1.4; text-align: left; }
.intro-input { box-sizing: border-box; width: 100%; min-height: 150rpx; padding: 16rpx 18rpx; border: 1rpx solid #dfe5da; border-radius: 15rpx; background: #fff; font-size: 24rpx; line-height: 1.5; }
.optional { margin-left: 8rpx; color: #8b968e; font-size: 21rpx; font-weight: 400; }
.game-options { margin-top: 4rpx; }
.save-actions { display: flex; gap: 14rpx; margin-top: 22rpx; }
.save-actions button { flex: 1; margin: 0; font-size: 25rpx; }
.local-note { margin-top: 16rpx; text-align: center; }
