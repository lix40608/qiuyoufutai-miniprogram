.legal-gate { min-height: 100vh; box-sizing: border-box; padding: 100rpx 36rpx 56rpx; background: #f7f7f2; }
.gate-brand { display:flex; align-items:center; gap:14rpx; color:#174b3c; font-size:28rpx; font-weight:800; }
.gate-brand image { width:58rpx; height:58rpx; }
.gate-title { margin-top:76rpx; color:#173d32; font-size:42rpx; line-height:1.3; font-weight:800; }
.gate-subtitle { margin-top:18rpx; color:#78867e; font-size:26rpx; line-height:1.6; }
.legal-links { margin-top:42rpx; padding:0 26rpx; border-radius:24rpx; }
.legal-link { min-height:118rpx; display:flex; align-items:center; justify-content:space-between; }
.link-title,.link-desc { display:block; }
.link-title { color:#193f34; font-size:29rpx; font-weight:750; }
.link-desc { margin-top:8rpx; color:#829087; font-size:22rpx; }
.arrow { color:#197257; font-size:23rpx; font-weight:700; }
.divider { height:1rpx; background:#e8ebe3; }
.check-row { display:flex; align-items:flex-start; gap:14rpx; margin-top:30rpx; color:#52655b; font-size:23rpx; line-height:1.55; }
.check { box-sizing:border-box; flex:none; width:34rpx; height:34rpx; margin-top:1rpx; border:2rpx solid #bac5bb; border-radius:9rpx; background:#fffefa; text-align:center; color:#fff; line-height:29rpx; font-size:23rpx; }
.check.checked { border-color:#197257; background:#197257; }
.check-disabled { opacity:.55; }
.inline-link { color:#197257; font-weight:650; }
.gate-error { margin-top:18rpx; color:#c74740; font-size:23rpx; }
.gate-submit { margin-top:38rpx; }
.gate-submit[disabled] { opacity:.45; }
.gate-exit { margin-top:28rpx; text-align:center; color:#7b8881; font-size:24rpx; }
.gate-footnote { margin-top:70rpx; color:#98a39b; text-align:center; font-size:21rpx; line-height:1.5; }
