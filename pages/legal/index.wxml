<view class="page legal-page">
  <view class="legal-heading">{{title}}</view>
  <view class="legal-version">版本：{{version}}</view>
  <view wx:for="{{sections}}" wx:key="title" class="card legal-section">
    <view class="legal-section-title">{{item.title}}</view>
    <view wx:for="{{item.paragraphs}}" wx:for-item="paragraph" wx:key="*this" class="legal-paragraph">{{paragraph}}</view>
  </view>
</view>
