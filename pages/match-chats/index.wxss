.match-chats-page { padding-bottom: 60rpx; }
.match-summary { padding: 24rpx; margin-bottom: 28rpx; }
.summary-line { display:flex; align-items:center; justify-content:space-between; gap:16rpx; }
.game-tag { padding:7rpx 12rpx; border-radius:9rpx; background:#eaf3e9; color:#24775c; font-size:21rpx; }
.match-state { color:#7d9286; font-size:21rpx; }
.match-title { margin-top:16rpx; color:#173b31; font-size:29rpx; font-weight:700; }
.match-meta { margin-top:9rpx; color:#7d9086; font-size:22rpx; }
.match-ended-reason { margin-top:12rpx; color:#77877d; font-size:22rpx; line-height:1.55; }
.section-title { display:flex; justify-content:space-between; align-items:center; margin:30rpx 4rpx 16rpx; color:#173b31; font-size:27rpx; font-weight:700; }
.section-count { color:#91a197; font-size:21rpx; font-weight:400; }
.match-conversation-group { padding: 0 24rpx; overflow: hidden; }
.conversation-row { display: flex; align-items: center; gap: 24rpx; padding: 20rpx 0; border-bottom: 1rpx solid #f0f3ed; }
.conversation-row:last-of-type { border-bottom: 0; }
.conversation-main { flex: 1; min-width: 0; }
.conversation-name { margin-bottom: 12rpx; color: #173b31; font-weight: 700; font-size: 30rpx; }
.conversation-status { margin-left: 18rpx; color: #197257; font-size: 22rpx; font-weight: 400; }
.conversation-avatar { width: 82rpx; height: 82rpx; flex: none; overflow: hidden; border-radius: 50%; background: #eef1eb; }
.conversation-preview { margin: 8rpx 0; color: #536b5e; font-size: 24rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.conversation-time { margin-top: 6rpx; font-size: 20rpx; }
.conversation-tail { display: flex; align-items: center; justify-content: flex-end; gap: 10rpx; flex: none; min-width: 66rpx; }
.unread-badge { display: inline-flex; align-items: center; justify-content: center; min-width: 34rpx; height: 34rpx; padding: 0 9rpx; border: 2rpx solid #fffefa; border-radius: 999rpx; background: #d65b55; box-shadow: 0 3rpx 8rpx rgba(128, 48, 43, .14); color: #fff; text-align: center; font-size: 18rpx; font-weight: 700; line-height: 1; box-sizing: border-box; }
.conversation-arrow { color: #a6b2aa; font-size: 36rpx; line-height: 1; }
.list-footer { padding: 24rpx 0 34rpx; color: #9aa69e; text-align: center; font-size: 21rpx; }
.retry-button { width:240rpx; margin:24rpx auto 0; border:0; border-radius:14rpx; background:#19745b; color:white; font-size:23rpx; }
.retry-button::after { border:0; }
