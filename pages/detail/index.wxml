<view wx:if="{{match}}" class="page detail-page">
  <view class="card">
    <view class="detail-top"><view class="tag">{{match.gameType}}</view><view class="status">{{match.status === 'cancelled' ? '已取消' : match.displayEnded ? '已过期' : match.status === 'matched' ? '已组局' : '招募中'}}</view></view>
    <view class="venue-label-row"><text class="detail-label">球房</text><view wx:if="{{distanceLabel}}" class="distance-entry" bindtap="openMap"><view class="pin-icon"><view class="pin-dot"></view></view><text>{{distanceLabel}}</text></view><view wx:elif="{{!hasUserLocation}}" class="distance-entry distance-prompt" bindtap="chooseLocation"><view class="pin-icon"><view class="pin-dot"></view></view><text>选择位置查看距离 ›</text></view></view><view class="venue-name">{{match.venue || '球房待选择'}}</view>
    <view class="time-block"><view class="time-icon">◷</view><view><view class="detail-label">开球时间</view><view class="time-value">{{match.startLabel}}</view></view></view>
    <map wx:if="{{hasVenueLocation}}" class="venue-map" latitude="{{match.venueLatitude}}" longitude="{{match.venueLongitude}}" scale="15" markers="{{markers}}" bindtap="openMap" />
    <view wx:else class="map-preview no-map"><view class="map-caption">暂无球房地图坐标</view></view>
    <view class="address-row"><view class="address-heading"><view class="detail-label">球房地址</view><view wx:if="{{hasVenueLocation}}" class="text-link" bindtap="openMap">查看地图 ›</view></view><view class="address-value">{{match.venueAddress || match.area || '暂无详细地址'}}</view></view>
    <view class="detail-information"><view wx:if="{{match.feeLabel}}" class="info-row"><text class="info-label">费用方式</text><text>{{match.feeLabel}}</text></view><view wx:if="{{match.level}}" class="info-row"><text class="info-label">水平偏好</text><text>{{match.level}}</text></view><view wx:if="{{match.note}}" class="info-row"><text class="info-label">备注</text><text class="info-note">{{match.note}}</text></view></view>
    <view wx:if="{{!isHost}}" class="divider"></view>
    <view wx:if="{{!isHost}}" class="host-row" catchtap="openHostProfile" data-user-id="{{match.hostUserId}}">
      <view class="host-avatar">
        <image wx:if="{{match.hostAvatar}}" class="host-avatar-image" src="{{match.hostAvatar}}" mode="aspectFill" />
        <image wx:else class="eight-ball-image" src="/assets/eight-ball.png" mode="aspectFit" />
      </view>
      <view class="host-copy">
        <view class="host-primary"><text class="host-name">{{match.hostName}}</text><text wx:if="{{match.hostAge}}">{{match.hostAge}}岁</text><text wx:if="{{match.hostGender}}">{{match.hostGender}}</text></view>
        <view wx:if="{{match.hostIntro}}" class="muted host-intro">{{match.hostIntro}}</view>
      </view>
      <view class="profile-arrow">查看资料 ›</view>
    </view>
  </view>

  <view wx:if="{{!isHost && match.status === 'recruiting' && !match.displayEnded}}" class="card-actions">
    <button class="primary-button action-button" bindtap="openChat" data-focus="confirm">确认组局</button>
    <button class="primary-button secondary-button action-button" bindtap="openChat" data-focus="chat">去聊聊</button>
  </view>
</view>
