.detail-page { padding-top: 28rpx; }
.card { padding: 26rpx; border: 1rpx solid #dfe5da; border-radius: 28rpx; background: #fffefa; }
.match-title { margin: 18rpx 0 8rpx; font-size: 34rpx; line-height: 1.35; font-weight: 800; }
.fee { color: #c78339; font-size: 24rpx; font-weight: 700; }
.map-preview { position: relative; height: 190rpx; margin-top: 22rpx; overflow: hidden; border-radius: 22rpx; background: repeating-linear-gradient(35deg, transparent 0 36rpx, #fff 38rpx 44rpx, transparent 46rpx 92rpx), repeating-linear-gradient(122deg, #e7eddf 0 58rpx, #fff 60rpx 66rpx, #e7eddf 68rpx 128rpx); }
.venue-map { width: 100%; height: 300rpx; margin-top: 22rpx; border-radius: 22rpx; overflow: hidden; }
.no-map { background: linear-gradient(135deg,#e7eddf,#f0f2ed); }
.map-pin { position: absolute; top: 48%; left: 54%; color: #e86c67; font-size: 40rpx; }
.map-caption { position: absolute; right: 12rpx; bottom: 10rpx; padding: 5rpx 9rpx; border-radius: 8rpx; background: #fffefa; color: #718178; font-size: 18rpx; }
.venue-row { margin-top: 16rpx; }
.venue-name { font-size: 28rpx; font-weight: 700; }
.text-link { color: #197257; font-size: 24rpx; font-weight: 700; }
.divider { height: 1rpx; margin: 22rpx 0; background: #dfe5da; }
.host-row { display: flex; align-items: center; gap: 14rpx; }
.host-avatar { width: 76rpx; height: 76rpx; flex: none; display: flex; align-items: center; justify-content: center; overflow: hidden; border: 2rpx solid #dfe5da; border-radius: 50%; background: #eef1eb; }
.host-avatar-image { width: 100%; height: 100%; }
.eight-ball { width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; border: 3rpx solid #393d3b; border-radius: 50%; background: radial-gradient(circle at 32% 24%, #686d69 0, #222523 30%, #080909 72%); box-shadow: inset -5rpx -7rpx 11rpx rgba(0,0,0,.45), inset 3rpx 4rpx 6rpx rgba(255,255,255,.12); }
.eight-ball text { width: 30rpx; height: 30rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #f5f5f2; color: #111; font-size: 21rpx; font-weight: 800; }
.host-copy { flex: 1; min-width: 0; }
.host-primary { display: flex; flex-wrap: wrap; align-items: center; gap: 12rpx; color: #718178; font-size: 22rpx; }
.host-name { color: #173128; font-size: 25rpx; font-weight: 700; }
.host-intro { margin-top: 5rpx; font-size: 22rpx; }
.profile-arrow { flex: none; color: #718178; font-size: 20rpx; }
.local-note { margin-top: 18rpx; padding: 14rpx 16rpx; border-radius: 14rpx; background: #fff3dc; color: #805a23; font-size: 22rpx; line-height: 1.5; }
.match-note { margin-top: 16rpx; color: #52645b; font-size: 25rpx; line-height: 1.6; white-space: pre-wrap; }
.card-actions { display: flex; gap: 14rpx; margin-top: 22rpx; }
.action-button { flex: 1; margin: 0; min-height: 82rpx; line-height: 82rpx; font-size: 26rpx; }
.contact-card { display: block; box-sizing: border-box; width: 100%; overflow: hidden; }
.contact-main-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; min-width: 0; }
.contact-copy { flex: 1; min-width: 0; }
.contact-title { color: #197257; font-size: 24rpx; font-weight: 700; }
.contact-hint { margin-top: 6rpx; color: #718178; font-size: 21rpx; line-height: 1.4; }
.contact-action { display: block; flex: none; width: 190rpx; max-width: 42%; min-width: 0; box-sizing: border-box; margin: 0; padding: 0 10rpx; height: 68rpx; line-height: 68rpx; border-radius: 18rpx; background: #197257; color: #fff; font-size: 23rpx; font-weight: 700; white-space: nowrap; }
.contact-action-disabled { background: #e5eae4; color: #849087; }
.local-contact-row { min-height: 68rpx; }
.contact-sharing-control { display:flex; align-items:flex-start; justify-content:space-between; gap:16rpx; min-width:0; margin:16rpx 0 0; padding-top:14rpx; border-top:1rpx solid #edf1eb; color:#89968d; font-size:21rpx; line-height:1.5; }
.contact-sharing-copy { flex:1; min-width:0; overflow-wrap:anywhere; word-break:break-word; }
.contact-sharing-link { flex:none; white-space:nowrap; color:#197257; font-weight:700; }
.detail-wechat-mask { position:fixed; inset:0; z-index:1000; display:flex; align-items:center; justify-content:center; padding:40rpx; box-sizing:border-box; background:rgba(20,37,30,.48); }
.detail-wechat-modal { width:100%; box-sizing:border-box; padding:34rpx 30rpx 26rpx; border-radius:24rpx; background:#fffefa; box-shadow:0 18rpx 58rpx rgba(19,43,32,.2); }
.detail-wechat-modal.keyboard-open { transform:translateY(-140rpx); }
.detail-wechat-title { color:#173128; font-size:32rpx; font-weight:800; text-align:center; }
.detail-wechat-input { width:100%; height:84rpx; margin-top:26rpx; padding:0 22rpx; box-sizing:border-box; border:1rpx solid #dfe5da; border-radius:14rpx; background:#f7f8f4; color:#173128; font-size:27rpx; }
.detail-wechat-hint { margin-top:16rpx; color:#718178; font-size:22rpx; line-height:1.6; }
.detail-wechat-actions { display:flex; gap:16rpx; margin-top:30rpx; }
.detail-wechat-actions button { display:flex; flex:1 1 0; align-items:center; justify-content:center; min-width:0; height:82rpx; margin:0; padding:0 16rpx; box-sizing:border-box; border-radius:16rpx; font-size:26rpx; font-weight:700; line-height:1.2; text-align:center; }
.detail-wechat-cancel { border:1rpx solid #dfe5da; background:#f7f8f4; color:#65766d; }
.detail-wechat-save { background:#197257; color:#fffefa; }
.contact-peer-state { flex:none; color:#8b968e; font-size:22rpx; }

.detail-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:26rpx}.status{color:#287f60;background:#eaf5eb;border-radius:24rpx;padding:7rpx 14rpx;font-size:21rpx}.detail-label{font-size:21rpx;color:#91a197}.venue-name{font-size:34rpx;line-height:1.35;margin-top:8rpx;color:#193c30}.time-block{display:flex;align-items:center;gap:14rpx;margin-top:22rpx;padding:16rpx 18rpx;border-radius:16rpx;background:#f0f6f0}.time-icon{width:42rpx;height:42rpx;line-height:42rpx;text-align:center;border-radius:50%;background:#dceee0;color:#21775c;font-size:28rpx}.time-value{margin-top:4rpx;font-size:26rpx;font-weight:650;color:#235440}.address-row{display:flex;align-items:center;gap:18rpx;margin-top:18rpx}.address-copy{flex:1;min-width:0}.address-value{margin-top:6rpx;color:#536a5c;font-size:24rpx;line-height:1.5}.text-link{flex:none}.detail-information{margin-top:22rpx}.info-row{display:flex;align-items:flex-start;gap:24rpx;margin-top:14rpx;color:#536a5c;font-size:24rpx;line-height:1.5}.info-label{flex:none;color:#91a197}.info-note{white-space:pre-wrap;word-break:break-all}
.address-row{display:block;margin-top:18rpx}.address-heading{display:flex;align-items:center;justify-content:space-between;gap:18rpx}.address-heading .text-link{padding:8rpx 0}.address-value{white-space:normal;overflow-wrap:anywhere;word-break:break-word;line-height:1.6}
.venue-map{height:420rpx}.map-preview{height:250rpx}.venue-distance{color:#568473;font-size:21rpx}

.venue-label-row{display:flex;align-items:center;gap:12rpx}.venue-distance{padding:5rpx 10rpx;border-radius:9rpx;background:#e4f1e5;color:#1c7355;font-size:22rpx;font-weight:700;line-height:1.35}

.venue-distance{padding:0;background:transparent;border-radius:0;color:#397b62;font-size:22rpx;font-weight:600}.distance-prompt{color:#54836f;font-size:21rpx;padding:8rpx 4rpx}

.distance-entry{display:inline-flex;align-items:center;gap:9rpx;min-height:44rpx;padding:0 6rpx;color:#397b62;font-size:22rpx;font-weight:600;line-height:1}.pin-icon{position:relative;box-sizing:border-box;width:20rpx;height:20rpx;border:3rpx solid currentColor;border-radius:50% 50% 50% 0;transform:rotate(-45deg);flex:none;margin:0 2rpx 4rpx}.pin-dot{position:absolute;width:5rpx;height:5rpx;border-radius:50%;background:currentColor;top:4rpx;left:4rpx}

/* 用球面高光、暗部和柔和投影表现黑八的材质。 */
.eight-ball{box-sizing:border-box;border:1rpx solid #25292a;background:radial-gradient(ellipse at 28% 19%,rgba(255,255,255,.7) 0%,rgba(255,255,255,.24) 7%,rgba(255,255,255,0) 21%),radial-gradient(circle at 36% 28%,#505456 0%,#1e2223 40%,#080a0b 76%,#020303 100%);box-shadow:inset -5rpx -7rpx 12rpx rgba(0,0,0,.65),inset 2rpx 2rpx 5rpx rgba(255,255,255,.13),0 3rpx 7rpx rgba(0,0,0,.2)}
.eight-ball text{background:radial-gradient(circle at 35% 30%,#fff 0%,#e8e7df 72%,#b8bab4 100%);color:#171b1a;box-shadow:inset -2rpx -2rpx 4rpx rgba(0,0,0,.18)}
