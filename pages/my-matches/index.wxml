<view class="page my-matches-page">
  <view class="page-title">我的约局</view>

  <view class="view-tabs">
    <view wx:for="{{views}}" wx:key="value" class="view-tab {{activeView === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="selectView">{{item.label}}</view>
  </view>

  <scroll-view wx:if="{{activeView === 'created'}}" class="filter-scroll" scroll-x="true" show-scrollbar="false">
    <view class="filter-row">
      <view wx:for="{{filters}}" wx:key="value" class="filter-chip {{activeFilter === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="selectFilter">{{item.label}}</view>
    </view>
  </scroll-view>

  <view wx:if="{{activeView === 'chatted'}}" class="empty-state">
    <view class="empty-icon">◌</view>
    <view class="empty-title">还没有聊过的约局</view>
    <view class="muted">加入一场约局后，可以在这里查看参与记录。</view>
    <button class="primary-button empty-button" bindtap="goPublish">发起一场约球</button>
  </view>

  <view wx:elif="{{visibleRecords.length}}">
    <view wx:for="{{visibleRecords}}" wx:key="id" class="match-card card" data-id="{{item.id}}" data-status="{{item.status}}" bindtap="openRecord">
      <view class="card-top">
          <view class="tag">{{item.status === 'draft' ? '编辑中' : item.displayEnded ? '已过期' : '组局中'}}</view>
        <view wx:if="{{item.status !== 'draft'}}" class="muted">{{item.displayEnded ? '公开展示已结束 · 记录仍保留' : ''}}</view>
      </view>
      <view class="match-title">{{item.title}}</view>
      <view class="muted">{{item.gameType || '玩法待填写'}} · {{item.startLabel}}</view>
      <view class="muted venue-line">{{item.venueName || '球房待选择'}}<text wx:if="{{item.venueArea}}"> · {{item.venueArea}}</text></view>
      <view class="card-actions">
        <button wx:if="{{item.status === 'draft'}}" class="primary-button" catchtap="openRecord" data-id="{{item.id}}" data-status="draft">继续编辑</button>
        <button wx:if="{{item.status === 'recruiting'}}" class="primary-button secondary-button" catchtap="openRecord" data-id="{{item.id}}" data-status="recruiting">查看详情</button>
        <button wx:if="{{item.status !== 'draft' && !item.displayEnded}}" class="primary-button cancel-button" catchtap="cancelRecord" data-id="{{item.id}}">管理 / 取消</button>
        <button wx:if="{{item.displayEnded}}" class="primary-button secondary-button" catchtap="openRecord" data-id="{{item.id}}" data-status="{{item.status}}">查看记录</button>
      </view>
    </view>
  </view>

  <view wx:elif="{{activeView === 'created'}}" class="empty-state">
    <view class="empty-icon">＋</view>
    <view class="empty-title">{{activeFilter === 'draft' ? '还没有保存的草稿' : activeFilter === 'expired' ? '还没有过期的约局' : '当前没有进行中的约局'}}</view>
    <view class="muted">发布一场约球，附近球友就能看到你。</view>
    <button class="primary-button empty-button" bindtap="goPublish">发起一场约球</button>
  </view>
</view>
