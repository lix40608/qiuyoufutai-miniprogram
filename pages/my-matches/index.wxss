.my-matches-page { padding-top: 34rpx; padding-bottom: 56rpx; }
.demo-banner { margin-top: 18rpx; padding: 16rpx 18rpx; border-radius: 16rpx; background: #fff3dc; color: #805a23; font-size: 22rpx; }
.view-tabs { display: flex; gap: 34rpx; margin-top: 30rpx; border-bottom: 1rpx solid #dfe5da; }
.view-tab { padding: 0 4rpx 16rpx; color: #718178; font-size: 27rpx; }
.view-tab.active { border-bottom: 5rpx solid #197257; color: #173128; font-weight: 800; }
.filter-scroll { margin: 18rpx -28rpx 0; white-space: nowrap; }
.filter-row { display: inline-flex; gap: 12rpx; padding: 0 28rpx; }
.filter-chip { padding: 12rpx 17rpx; border-radius: 26rpx; background: #e7ebe2; color: #52645b; font-size: 21rpx; }
.filter-chip.active { background: #197257; color: #fff; }
.match-card { margin-top: 18rpx; padding: 24rpx; border: 1rpx solid #dfe5da; border-radius: 24rpx; background: #fffefa; }
.card-top { display: flex; align-items: center; justify-content: space-between; }
.match-title { margin: 17rpx 0 9rpx; font-size: 29rpx; font-weight: 800; }
.venue-line { margin-top: 6rpx; }
.card-actions { display: flex; gap: 12rpx; margin-top: 18rpx; }
.card-actions button { flex: 1; margin: 0; font-size: 23rpx; }
.cancel-button { background: #f2e8df; color: #805a43; }
.card-actions .cancel-button { flex: 0 0 38%; margin-left: auto; }
.empty-state { padding: 110rpx 18rpx 60rpx; text-align: center; }
.empty-icon { margin-bottom: 15rpx; color: #93aa9b; font-size: 70rpx; }
.empty-title { margin-bottom: 10rpx; font-size: 29rpx; font-weight: 800; }
.empty-button { display: inline-flex; margin-top: 28rpx; padding: 0 34rpx; font-size: 24rpx; }

.record-time{font-size:32rpx;font-weight:700;color:#193c30;margin-top:18rpx}.record-venue{font-size:26rpx;font-weight:600;color:#1b765c;background:#f0f5ed;border-radius:12rpx;padding:14rpx;margin-top:12rpx}.record-meta,.record-extra{margin-top:12rpx}.record-extra{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

.record-time{display:flex;align-items:baseline;gap:18rpx;font-size:27rpx;font-weight:600;color:#234638}.time-label{font-size:22rpx;font-weight:400;color:#83958b;flex:none}

.match-card{border-color:#e2eae2;border-radius:28rpx;box-shadow:0 8rpx 24rpx rgba(35,76,54,.045)}.record-venue{padding:0;margin-top:24rpx;background:none}.record-label{font-size:20rpx;font-weight:500;color:#91a197}.record-venue-name{margin-top:6rpx;font-size:32rpx;font-weight:700;color:#17392f;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.record-time{align-items:center;gap:13rpx;padding:17rpx 18rpx;background:#f0f6f0;border-radius:16rpx;margin-top:20rpx}.record-clock{width:44rpx;height:44rpx;line-height:44rpx;text-align:center;border-radius:50%;background:#dceee0;color:#21775c;font-size:30rpx}.record-time-value{margin-top:3rpx;color:#235440;font-size:25rpx;font-weight:650}
.list-footer { padding: 28rpx 0 36rpx; text-align: center; font-size: 22rpx; }
.chat-partner { margin-bottom: 18rpx; color: #70857a; font-size: 23rpx; }
