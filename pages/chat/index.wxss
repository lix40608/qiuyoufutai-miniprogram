.chat-page { width: 100%; min-width: 0; height: 100vh; display: flex; flex-direction: column; overflow: hidden; box-sizing: border-box; background: #f4f5f1; }
.confirmation-toast { position: fixed; top: 16rpx; left: 24rpx; right: 24rpx; z-index: 20; padding: 18rpx 22rpx; border: 1rpx solid #cfe2d5; border-radius: 18rpx; background: #fffefa; box-shadow: 0 8rpx 24rpx rgba(34, 56, 43, .12); color: #197257; font-size: 22rpx; line-height: 1.45; text-align: center; }
.preview-banner { flex: none; padding: 12rpx 24rpx; text-align: center; background: #fff3dc; color: #805a23; font-size: 21rpx; }
.match-pin { flex: none; margin: 16rpx 20rpx 10rpx; padding: 18rpx 20rpx 16rpx; border: 1rpx solid #dfe5da; border-radius: 28rpx; background: #fffefa; box-shadow: 0 6rpx 18rpx rgba(34, 56, 43, .06); }
.pin-top { display: flex; align-items: center; gap: 10rpx; }
.pin-status { padding: 8rpx 12rpx; border-radius: 10rpx; background: #eaf0e4; color: #197257; font-size: 21rpx; font-weight: 700; }
.pin-game { margin-left: auto; color: #718178; font-size: 21rpx; }
.pin-title { margin-top: 8rpx; overflow: hidden; color: #173128; font-size: 25rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.pin-meta, .pin-venue { margin-top: 6rpx; color: #718178; font-size: 20rpx; }
.confirm-panel { flex: none; margin: 0 20rpx 10rpx; padding: 22rpx; border: 1rpx solid #cfe4d3; border-radius: 30rpx; background: #e8f3e6; box-shadow: 0 4rpx 12rpx rgba(23, 49, 40, .04); }
.confirm-head { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.confirm-title { color: #173128; font-size: 24rpx; font-weight: 700; }
.confirm-progress { flex: none; padding: 7rpx 10rpx; border-radius: 10rpx; background: #e3eee0; color: #197257; font-size: 19rpx; font-weight: 700; white-space: nowrap; }
.confirm-hint { margin-top: 8rpx; color: #60766a; font-size: 20rpx; line-height: 1.45; }
.confirm-button { display: flex; align-items: center; justify-content: center; width: 100%; height: 76rpx; margin: 12rpx 0 0; padding: 0 16rpx; box-sizing: border-box; border-radius: 22rpx; background: #197257; color: #fff; font-size: 23rpx; font-weight: 700; line-height: 1; white-space: nowrap; }
.invite-card { flex: none; margin: 0 20rpx 10rpx; padding: 18rpx 20rpx; border: 1rpx solid #cfe4d3; border-radius: 22rpx; background: #fffefa; box-shadow: 0 4rpx 12rpx rgba(23, 49, 40, .05); }
.invite-title { color: #173128; font-size: 22rpx; font-weight: 700; line-height: 1.45; }
.invite-actions { display: flex; justify-content: flex-end; gap: 12rpx; margin-top: 12rpx; }
.invite-actions button { height: 64rpx; margin: 0; padding: 0 24rpx; border-radius: 18rpx; font-size: 21rpx; line-height: 64rpx; }
.invite-later { border: 1rpx solid #dfe5da; background: #f4f5f1; color: #60766a; }
.invite-confirm { background: #197257; color: #fff; font-weight: 700; }
.message-region { position: relative; flex: 1; min-height: 0; display: flex; }
.message-list { flex: 1; width: 100%; height: 100%; min-height: 0; padding: 12rpx 22rpx 18rpx; box-sizing: border-box; }
.new-messages-tip { position: absolute; right: 28rpx; bottom: 22rpx; z-index: 5; display: flex; align-items: center; gap: 8rpx; max-width: 80%; padding: 13rpx 20rpx; border: 1rpx solid #cfe4d3; border-radius: 28rpx; background: #fffefa; box-shadow: 0 5rpx 18rpx rgba(23, 49, 40, .14); color: #197257; font-size: 21rpx; font-weight: 600; }
.new-messages-arrow { font-size: 25rpx; line-height: 1; }
.date-divider { width: max-content; margin: 8rpx auto 28rpx; padding: 7rpx 16rpx; border-radius: 20rpx; background: #e9ece6; color: #7d8980; font-size: 19rpx; }
.system-message { max-width: 610rpx; margin: 0 auto 28rpx; padding: 13rpx 20rpx; border-radius: 15rpx; background: #e9ece6; color: #738077; font-size: 21rpx; line-height: 1.5; text-align: center; }
.message-row { display: flex; align-items: flex-start; gap: 14rpx; margin: 0 0 28rpx; }
.mine-row { justify-content: flex-end; }
.message-avatar { width: 64rpx; height: 64rpx; flex: none; display: flex; align-items: center; justify-content: center; overflow: hidden; border-radius: 50%; font-size: 22rpx; font-weight: 700; }
.avatar-image { width: 100%; height: 100%; border-radius: 50%; }
.other-avatar { background: #dce9d8; color: #35664f; }
.mine-avatar { background: #d5e9df; color: #197257; }
.bubble-wrap { max-width: 76%; }
.message-time { margin: 0 0 8rpx; color: #9aa39b; font-size: 19rpx; }
.message-sender { margin-bottom: 4rpx; color: #60766a; font-size: 20rpx; }
.mine-row .message-time { text-align: right; }
.bubble { padding: 18rpx 21rpx; border-radius: 6rpx 20rpx 20rpx 20rpx; color: #23372d; font-size: 26rpx; line-height: 1.5; word-break: break-all; }
.other-bubble { background: #fffefa; }
.mine-bubble { border-radius: 20rpx 6rpx 20rpx 20rpx; background: #d9eddf; }
.composer { flex: none; display: flex; align-items: center; gap: 14rpx; min-width: 0; margin: 0 20rpx calc(12rpx + env(safe-area-inset-bottom)); padding: 14rpx; box-sizing: border-box; border: 1rpx solid #dfe5da; border-radius: 30rpx; background: #fffefa; }
.message-input-shell { flex: 1 1 0; min-width: 0; height: 72rpx; display: flex; align-items: center; padding: 0 16rpx; box-sizing: border-box; border-radius: 18rpx; background: #f1f3ef; }
.message-input { flex: 1; min-width: 0; height: 100%; padding: 0; box-sizing: border-box; color: #173128; font-size: 25rpx; }
.send-button-wrap { flex: 0 0 104rpx; width: 104rpx; min-width: 104rpx; max-width: 104rpx; box-sizing: border-box; }
.send-button { display: flex; flex: none; align-items: center; justify-content: center; width: 100%; min-width: 0; max-width: 100%; height: 72rpx; margin: 0; padding: 0 8rpx; box-sizing: border-box; border-radius: 22rpx; background: #197257; color: #fff; font-size: 22rpx; font-weight: 700; line-height: 1; white-space: nowrap; }
.send-button[disabled] { background: #dfe4dd; color: #849087; opacity: 1; }
.highlight-pin { border-color: #197257; }
.sync-error { padding: 12rpx 24rpx; background: #fff3dc; color: #805a23; font-size: 22rpx; }
.failed-message { padding-top: 10rpx; color: #b34235; font-size: 22rpx; }
.closed-banner { padding: 22rpx 24rpx calc(22rpx + env(safe-area-inset-bottom)); color: #718178; text-align: center; font-size: 24rpx; background: #fffefa; }
.closure-notice { background: #fff3dc; color: #805a23; }
button[disabled] { opacity: .5; }
