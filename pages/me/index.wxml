<view wx:if="{{!loggedIn}}" class="page me-page guest-me-page">
  <view class="guest-me-hero card">
    <view class="guest-me-brand">球友赴台 · 球友档案</view>
    <view class="guest-me-title">你的下一场球，<br/>从这里开始</view>
    <view class="guest-me-description">登录后发布约球、联系球友、查看消息与组局进度。</view>
    <button class="guest-me-login" bindtap="openGuestLogin" data-kind="me">微信一键登录</button>
  </view>
  <view class="section-title guest-section-title">现在就能做</view>
  <view class="card guest-action-tile" bindtap="goGuestBrowse" data-tab="find"><view class="guest-tile-icon">⌕</view><view class="guest-tile-copy"><view>逛附近的约球</view><view class="muted">看看球友正在约什么局</view></view><text class="muted">›</text></view>
  <view class="card guest-action-tile" bindtap="goGuestBrowse" data-tab="home"><view class="guest-tile-icon">⌂</view><view class="guest-tile-copy"><view>回到球友首页</view><view class="muted">浏览推荐球局和玩法</view></view><text class="muted">›</text></view>
  <view class="section-title guest-section-title">关于球友赴台</view>
  <view class="card menu-card guest-about-entry" bindtap="openAboutUs"><view><view>关于我们</view><view class="muted">用户协议、隐私政策与版本信息</view></view><text class="muted">›</text></view>
  <login-guide id="loginGuide" bind:success="onLoginSuccess" />
</view>
<view wx:else class="page me-page">
  <view class="page-title">我的</view>
  <view class="section-title">个人资料</view>
  <view class="card personal-card" bindtap="editPersonalProfile">
    <view class="personal-avatar">
      <image wx:if="{{personal.avatarPath}}" class="personal-avatar-image" src="{{personal.avatarPath}}" mode="aspectFill" />
      <image wx:else class="eight-ball-image" src="/assets/eight-ball.png" mode="aspectFit" />
    </view>
    <view class="personal-main">
      <view class="profile-name">{{personal.nickname || '未设置昵称'}}</view>
      <view wx:if="{{personalMeta}}" class="muted">{{personalMeta}}</view>
    </view>
    <view class="edit-link">{{personalComplete ? '编辑' : '去完善'}} ›</view>
  </view>

  <block wx:if="{{archiveConfigured}}">
    <view class="section-title">球员档案</view>
    <view class="profile-card card">
    <view class="profile-head">
      <view class="profile-main archive-content">
        <view wx:if="{{archive.intro}}" class="archive-intro">{{archive.intro}}</view>
        <view wx:if="{{!archive.intro && archive.gameTypes.length}}" class="muted">常打玩法</view>
      </view>
    </view>
    <view wx:if="{{archive.gameTypes && archive.gameTypes.length}}" class="archive-games">
      <view wx:for="{{archive.gameTypes}}" wx:key="*this" class="archive-game">{{item}}</view>
    </view>
  </view>
  </block>

  <view class="card menu-card message-menu" bindtap="showMessages">
    <view><view>消息与通知</view><view class="muted">聊天消息与约局状态通知</view></view><view class="message-side"><view wx:if="{{unreadCount}}" class="message-unread"></view><text class="muted">›</text></view>
  </view>

  <view class="section-title settings-title">设置</view>
  <view class="card menu-card wechat-card" bindtap="openWechatEditor">
    <view class="wechat-copy">
      <view class="wechat-label">微信号</view>
      <view wx:if="{{wechatId}}" class="wechat-value">{{wechatId}}</view>
      <view class="wechat-hint">{{wechatId ? '组局成功后，球友可复制微信联系你' : '填写后，组局成功的球友可复制微信联系你'}}</view>
    </view>
    <view class="wechat-action" wx:if="{{!wechatId}}"><text>去填写</text><text class="wechat-chevron">›</text></view>
    <text class="wechat-chevron" wx:else>›</text>
  </view>

  <view class="card menu-card about-menu" bindtap="openAboutUs">
    <view><view>关于我们</view><view class="muted">用户协议、隐私政策与产品信息</view></view><text class="muted">›</text>
  </view>

  <view class="account-actions">
    <button class="account-action-button logout-button" bindtap="confirmLogout">退出登录</button>
    <button class="account-action-button delete-account-button" bindtap="confirmDeleteAccount">注销账号</button>
  </view>

  <view wx:if="{{wechatEditorVisible}}" class="modal-mask" catchtap="closeWechatEditor">
    <view class="wechat-editor-modal {{keyboardVisible ? 'keyboard-open' : ''}}" catchtap="stopModalTap">
      <view class="modal-title">填写微信号</view>
      <view class="wechat-input-wrap">
        <input class="wechat-input" value="{{wechatDraft}}" maxlength="20" placeholder="请输入微信号" adjust-position="false" cursor-spacing="24" bindinput="onWechatInput" bindkeyboardheightchange="onWechatKeyboardHeightChange" />
        <view wx:if="{{wechatDraft}}" class="wechat-clear" catchtap="clearWechatDraft"><text>×</text></view>
      </view>
      <view class="wechat-modal-hint">组局成功后，对方可复制联系你；微信号不会公开展示。</view>
      <view class="modal-actions"><button class="modal-secondary" bindtap="closeWechatEditor">取消</button><button class="modal-primary" loading="{{savingWechat}}" disabled="{{savingWechat}}" bindtap="saveWechatId">保存</button></view>
    </view>
  </view>
  <login-guide id="loginGuide" bind:success="onLoginSuccess" />
</view>
