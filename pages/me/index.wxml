<view class="page me-page">
  <view class="page-title">我的</view>
  <view class="section-title">个人资料</view>
  <view class="card personal-card" bindtap="editPersonalProfile">
    <view class="personal-avatar">
      <image wx:if="{{personal.avatarPath}}" class="personal-avatar-image" src="{{personal.avatarPath}}" mode="aspectFill" />
      <image wx:else class="eight-ball-image" src="/assets/eight-ball.png" mode="aspectFit" />
    </view>
    <view class="personal-main">
      <view class="profile-name">{{personal.nickname || '未设置昵称'}}</view>
      <view wx:if="{{personalMeta}}" class="muted">{{personalMeta}}</view>
    </view>
    <view class="edit-link">{{personalComplete ? '编辑' : '去完善'}} ›</view>
  </view>

  <block wx:if="{{archiveConfigured}}">
    <view class="section-title">球员档案</view>
    <view class="profile-card card">
    <view class="profile-head">
      <view class="profile-main archive-content">
        <view wx:if="{{archive.intro}}" class="archive-intro">{{archive.intro}}</view>
        <view wx:if="{{!archive.intro && archive.gameTypes.length}}" class="muted">常打玩法</view>
      </view>
    </view>
    <view wx:if="{{archive.gameTypes && archive.gameTypes.length}}" class="archive-games">
      <view wx:for="{{archive.gameTypes}}" wx:key="*this" class="archive-game">{{item}}</view>
    </view>
  </view>
  </block>

  <view class="card menu-card message-menu" bindtap="showMessages">
    <view><view>消息与通知</view><view class="muted">聊天消息与约局状态通知</view></view><view class="message-side"><view wx:if="{{unreadCount}}" class="message-unread"></view><text class="muted">›</text></view>
  </view>

  <view class="section-title settings-title">设置</view>
  <view class="card wechat-card">
    <view class="wechat-row"><view class="wechat-label">微信号</view><button class="wechat-edit-button" bindtap="openWechatEditor">{{wechatId ? '修改' : '去填写'}}</button></view>
    <view class="wechat-hint">仅在双方确认组局后，经你授权向本场对方展示；不会公开显示。</view>
  </view>

  <view class="card menu-card about-menu" bindtap="openAboutUs">
    <view><view>关于我们</view><view class="muted">用户协议、隐私政策与产品信息</view></view><text class="muted">›</text>
  </view>

  <view class="section-title account-title">账号管理</view>
  <button class="account-action-button logout-button" bindtap="confirmLogout">退出登录</button>
  <button class="account-action-button delete-account-button" bindtap="confirmDeleteAccount">注销账号</button>

  <view wx:if="{{wechatEditorVisible}}" class="modal-mask" catchtap="closeWechatEditor">
    <view class="wechat-editor-modal" catchtap="stopModalTap">
      <view class="modal-title">填写微信号</view>
      <input class="wechat-input" value="{{wechatDraft}}" maxlength="20" placeholder="请输入微信号" bindinput="onWechatInput" />
      <view class="wechat-modal-hint">微信号仅用于约球后的联系。你可以按单场授权对方查看；不会公开展示。</view>
      <view class="modal-actions"><button class="modal-secondary" bindtap="closeWechatEditor">取消</button><button class="modal-primary" loading="{{savingWechat}}" disabled="{{savingWechat}}" bindtap="saveWechatId">保存</button></view>
    </view>
  </view>
</view>
