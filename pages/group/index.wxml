<import src="../../templates/my-game-card.wxml" />
<view class="page group-page">
  <block wx:if="{{!loggedIn}}">
    <view class="guest-group-heading"><view class="guest-group-title-page">我的约球</view><view class="guest-group-subtitle">发布、沟通和管理你的每一场球</view></view>
    <view class="guest-group-hero"><image src="/assets/eight-ball.png" mode="aspectFit"/><view class="guest-group-eyeline">YOUR GAMES</view><view class="guest-group-title">登录后，继续你的球局</view><view class="guest-group-copy">发布约球、查看聊过的球局，也能及时跟进组局状态。</view><button class="guest-group-login" bindtap="openGuestLogin" data-kind="group">微信一键登录</button></view>
    <view class="section-title guest-group-section-title">登录后可管理</view>
    <view class="guest-group-link locked" bindtap="openGuestLogin" data-kind="group"><view>我发起的<view class="muted">管理招募中、已组局和已结束的球局</view></view><text>›</text></view>
    <view class="guest-group-link locked" bindtap="openGuestLogin" data-kind="group"><view>我聊过的<view class="muted">按对局查看发起聊天和确认邀请的球友</view></view><text>›</text></view>
    <view class="guest-group-link locked" bindtap="openGuestLogin" data-kind="group"><view>草稿<view class="muted">保存尚未发布的约球信息</view></view><text>›</text></view>
    <view class="section-title guest-group-section-title">先看看附近球局</view>
    <view class="guest-group-link" bindtap="browseMatches"><view>逛逛附近的约球<view class="muted">先浏览公开球局，找到合适的再登录联系</view></view><text>›</text></view>
  </block>
  <block wx:else>
    <view class="heading"><view class="title">我的约球</view></view>
    <view class="publish-entry" bindtap="publish"><view class="publish-copy"><view class="publish-title">发布约球</view><view class="publish-subtitle">选择球房和时间，发起一场约球</view></view><view class="publish-arrow">↗</view></view>
    <view class="tabs"><view class="tab {{activeView === 'created' ? 'active' : ''}}" data-view="created" bindtap="selectView">我发起的</view><view class="tab {{activeView === 'chatted' ? 'active' : ''}}" data-view="chatted" bindtap="selectView">我聊过的</view></view>
    <view class="recent-heading"><text>{{activeView === 'created' ? '最近发起' : '最近聊过'}}</text><view class="view-all" bindtap="allMatches">查看全部 <text>›</text></view></view>
    <view wx:if="{{loading}}" class="empty">正在加载约球…</view>
    <view wx:elif="{{loadError}}" class="empty">{{loadError}} <text class="retry" bindtap="refresh">重新加载</text></view>
    <block wx:elif="{{activeView === 'created'}}">
      <block wx:for="{{recentCreated}}" wx:key="id"><template is="created-game-card" data="{{item, hasUserLocation}}" /></block>
      <view wx:if="{{!recentCreated.length}}" class="empty">还没有发起过约球</view>
      <view class="section"><text>草稿</text><text class="section-hint">最近编辑</text></view>
      <view wx:if="{{latestDraft}}" class="draft" bindtap="openRecord" data-id="{{latestDraft.id}}" data-status="draft"><view class="draft-icon">✎</view><view class="draft-copy"><view class="draft-title">{{latestDraft.title}}</view><view class="draft-subtitle">{{latestDraft.venueName || '地点待选择'}} · 编辑中</view></view><view class="arrow">›</view></view><view wx:else class="empty">暂无草稿</view>
    </block>
    <block wx:else>
      <view wx:if="{{!chatted.length}}" class="empty">还没有聊过的约球</view>
      <block wx:for="{{chatted}}" wx:key="conversationId"><template is="chatted-game-card" data="{{item, hasUserLocation}}" /></block>
    </block>
  </block>
  <login-guide id="loginGuide" bind:success="onLoginSuccess" />
</view>
<cancel-match-dialog id="cancelMatchDialog" bind:success="onCancelSuccess" />
