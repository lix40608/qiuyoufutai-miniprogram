.group-page{padding:36rpx 38rpx 70rpx;color:#183c35}.heading{margin:4rpx 0 26rpx}.eyebrow{font-size:21rpx;letter-spacing:3rpx;color:#82978b;font-weight:600}.title{font-size:50rpx;font-weight:700;margin-top:8rpx}.publish-entry{display:flex;align-items:center;background:#e0eee4;border:1rpx solid #d1e5d7;border-radius:28rpx;padding:28rpx 30rpx;margin-bottom:42rpx}.publish-copy{flex:1}.publish-title{font-size:30rpx;font-weight:700;color:#165b48}.publish-subtitle{font-size:22rpx;color:#709483;margin-top:8rpx}.publish-arrow{width:62rpx;height:62rpx;line-height:62rpx;text-align:center;border-radius:50%;background:#146b55;color:#fff;font-size:36rpx}.tabs{display:flex;gap:50rpx;border-bottom:1rpx solid #dce7dd}.tab{padding:0 2rpx 20rpx;color:#9baaa1;font-size:29rpx;font-weight:650}.tab.active{color:#183c35;border-bottom:5rpx solid #1e8164}.section{display:flex;justify-content:space-between;align-items:center;font-size:27rpx;font-weight:700;margin:40rpx 2rpx 18rpx}.section-hint{font-size:21rpx;color:#9aa9a0;font-weight:400}.match-card,.draft{background:#fff;border-radius:28rpx;overflow:hidden}.match-top{display:flex;gap:20rpx;padding:28rpx}.date-block{width:112rpx;min-height:94rpx;display:flex;align-items:center;justify-content:center;text-align:center;border-radius:20rpx;background:#eaf4eb;color:#207057;font-size:23rpx;font-weight:650;padding:8rpx;box-sizing:border-box}.match-main{flex:1;min-width:0}.match-title{font-size:30rpx;font-weight:700;margin:5rpx 0 12rpx}.match-meta,.match-bottom,.draft-subtitle{color:#899991;font-size:22rpx}.badge{font-size:20rpx;color:#25815f;background:#e9f7e9;border-radius:30rpx;padding:8rpx 12rpx;align-self:flex-start;white-space:nowrap}.match-bottom{display:flex;justify-content:space-between;align-items:center;border-top:1rpx solid #f0f4ef;padding:18rpx 28rpx}.actions{display:flex;align-items:center;gap:18rpx}.manage{color:#899a90}.detail{background:#eef5ef;color:#2a765c;border-radius:12rpx;padding:12rpx 16rpx;font-weight:600}.draft{display:fl