.group-page{padding:36rpx 38rpx 70rpx;color:#183c35}.heading{margin:4rpx 0 26rpx}.eyebrow{font-size:21rpx;letter-spacing:3rpx;color:#82978b;font-weight:600}.title{font-size:50rpx;font-weight:700;margin-top:8rpx}.publish-entry{display:flex;align-items:center;background:#e0eee4;border:1rpx solid #d1e5d7;border-radius:28rpx;padding:28rpx 30rpx;margin-bottom:42rpx}.publish-copy{flex:1}.publish-title{font-size:30rpx;font-weight:700;color:#165b48}.publish-subtitle{font-size:22rpx;color:#709483;margin-top:8rpx}.publish-arrow{width:62rpx;height:62rpx;line-height:62rpx;text-align:center;border-radius:50%;background:#146b55;color:#fff;font-size:36rpx}.tabs{display:flex;gap:50rpx;border-bottom:1rpx solid #dce7dd}.tab{padding:0 2rpx 20rpx;color:#9baaa1;font-size:29rpx;font-weight:650}.tab.active{color:#183c35;border-bottom:5rpx solid #1e8164}.section{display:flex;justify-content:space-between;align-items:center;font-size:27rpx;font-weight:700;margin:40rpx 2rpx 18rpx}.section-hint{font-size:21rpx;color:#9aa9a0;font-weight:400}.match-card,.draft{background:#fff;border-radius:28rpx;overflow:hidden}.match-top{display:flex;gap:20rpx;padding:28rpx}.date-block{width:112rpx;min-height:94rpx;display:flex;align-items:center;justify-content:center;text-align:center;border-radius:20rpx;background:#eaf4eb;color:#207057;font-size:23rpx;font-weight:650;padding:8rpx;box-sizing:border-box}.match-main{flex:1;min-width:0}.match-title{font-size:30rpx;font-weight:700;margin:5rpx 0 12rpx}.match-meta,.match-bottom,.draft-subtitle{color:#899991;font-size:22rpx}.badge{font-size:20rpx;color:#25815f;background:#e9f7e9;border-radius:30rpx;padding:8rpx 12rpx;align-self:flex-start;white-space:nowrap}.match-bottom{display:flex;justify-content:space-between;align-items:center;border-top:1rpx solid #f0f4ef;padding:18rpx 28rpx}.actions{display:flex;align-items:center;gap:18rpx}.manage{color:#899a90}.detail{background:#eef5ef;color:#2a765c;border-radius:12rpx;padding:12rpx 16rpx;font-weight:600}.draft{display:flex;align-items:center;gap:20rpx;padding:24rpx}.draft-icon{width:65rpx;height:65rpx;line-height:65rpx;text-align:center;background:#edf3ed;color:#608c72;border-radius:18rpx;font-size:32rpx}.draft-copy{flex:1;min-width:0}.draft-title{font-size:26rpx;font-weight:700;margin-bottom:8rpx}.arrow{color:#a7b8ac;font-size:40rpx}.all-entry{display:flex;justify-content:space-between;border-bottom:1rpx solid #dfe9df;padding:30rpx 2rpx;color:#648071;font-size:25rpx;font-weight:600}.empty{text-align:center;padding:34rpx 0;color:#99aaa0;font-size:23rpx}.retry{color:#1d795d}.chatted{margin-bottom:18rpx}
.match-info{padding:0 28rpx 20rpx;color:#899991;font-size:22rpx}.match-actions{display:flex;gap:16rpx;border-top:1rpx solid #f0f4ef;padding:20rpx 28rpx}.match-actions button{flex:1;margin:0;font-size:23rpx;line-height:64rpx;padding:0;border-radius:12rpx}.match-actions button::after{border:0}.match-actions .detail{background:#19745b;color:#fff}.match-actions .manage{background:#f1f5ef;color:#687f72}

.summary-head{display:flex;align-items:center;justify-content:space-between;padding:26rpx 28rpx 0}.summary-tag{font-size:22rpx;color:#24775c;background:#eaf3e9;padding:8rpx 12rpx;border-radius:8rpx}.summary-time{padding:20rpx 28rpx 0;font-size:34rpx;font-weight:700;color:#193c30}.summary-venue{display:flex;align-items:center;gap:10rpx;margin:14rpx 28rpx 0;padding:14rpx 16rpx;background:#f0f5ed;border-radius:12rpx;color:#1b765c}.summary-venue-name{flex:1;min-width:0;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-size:26rpx;font-weight:600}.summary-meta,.summary-extra{padding:14rpx 28rpx 0;color:#899991;font-size:22rpx;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.summary-meta:last-of-type{padding-bottom:20rpx}.match-actions{margin-top:20rpx}

.summary-time{display:flex;align-items:baseline;gap:18rpx;font-size:27rpx;font-weight:600;color:#234638}.time-label{font-size:22rpx;font-weight:400;color:#83958b;flex:none}

.event-venue{display:flex;align-items:center;gap:16rpx;margin:22rpx 28rpx 0}.event-venue-copy{min-width:0;flex:1}.event-label{font-size:20rpx;font-weight:500;color:#91a197;line-height:1.3}.event-venue-name{font-size:32rpx;font-weight:700;color:#17392f;line-height:1.35;margin-top:6rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.event-map{flex:none;color:#258364;font-size:21rpx;font-weight:600}.event-time-row{display:flex;align-items:center;gap:13rpx;margin:20rpx 28rpx 0;padding:17rpx 18rpx;background:#f0f6f0;border-radius:16rpx}.event-clock{width:44rpx;height:44rpx;line-height:44rpx;text-align:center;border-radius:50%;background:#dceee0;color:#21775c;font-size:30rpx}.event-time-value{margin-top:3rpx;color:#235440;font-size:25rpx;font-weight:650}

.venue-title-row{display:flex;align-items:baseline;gap:16rpx;min-width:0;margin-top:6rpx}.venue-title-row .event-venue-name{flex:1;min-width:0;margin-top:0}.venue-title-row .event-map{line-height:1.35;white-space:nowrap}

.venue-label-row{display:flex;align-items:center;gap:12rpx}.distance-entry{display:inline-flex;align-items:center;gap:9rpx;min-height:44rpx;padding:0 6rpx;color:#397b62;font-size:22rpx;font-weight:600;line-height:1}.pin-icon{position:relative;box-sizing:border-box;width:20rpx;height:20rpx;border:3rpx solid currentColor;border-radius:50% 50% 50% 0;transform:rotate(-45deg);flex:none;margin:0 2rpx 4rpx}.pin-dot{position:absolute;width:5rpx;height:5rpx;border-radius:50%;background:currentColor;top:4rpx;left:4rpx}
.list-footer { padding: 28rpx 0 36rpx; text-align: center; font-size: 22rpx; }
.chat-link{position:relative;display:flex;align-items:center;gap:8rpx}.chat-entry-button{position:relative;flex:1;background:#19745b!important;color:#fff!important;border-radius:14rpx;font-size:24rpx;line-height:70rpx}.chat-entry-button::after{border:0}.chat-unread-badge{display:inline-block;margin-left:10rpx;min-width:28rpx;height:28rpx;padding:0 8rpx;border-radius:20rpx;background:#d8564e;color:#fff;font-size:18rpx;line-height:28rpx;vertical-align:4rpx}.action-unread-dot{width:14rpx;height:14rpx;border:3rpx solid #fffefa;border-radius:50%;background:#d8564e;box-sizing:content-box}
.partner-label { padding: 16rpx 28rpx 0; color: #70857a; font-size: 22rpx; }
.match-actions .manage { flex: 0 0 44%; margin-left: auto; }
