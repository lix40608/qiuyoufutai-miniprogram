.partner-label { padding: 16rpx 28rpx 0; color: #70857a; font-size: 22rpx; }
.match-actions .manage { display:flex; align-items:center; justify-content:center; box-sizing:border-box; flex:1 1 0; min-width:0; min-height:80rpx; margin-left:0; padding:0 24rpx; border:1rpx solid #e1e9df; border-radius:18rpx; color:#687f72; font-size:24rpx; font-weight:650; line-height:1.2; text-align:center; }
