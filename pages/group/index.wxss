@import "../../styles/my-game-card.wxss";
.group-page{padding:36rpx 38rpx 70rpx;color:#183c35}.heading{margin:4rpx 0 26rpx}.eyebrow{font-size:21rpx;letter-spacing:3rpx;color:#82978b;font-weight:600}.title{font-size:50rpx;font-weight:700;margin-top:8rpx}.publish-entry{display:flex;align-items:center;background:#e0eee4;border:1rpx solid #d1e5d7;border-radius:28rpx;padding:28rpx 30rpx;margin-bottom:42rpx}.publish-copy{flex:1}.publish-title{font-size:30rpx;font-weight:700;color:#165b48}.publish-subtitle{font-size:22rpx;color:#709483;margin-top:8rpx}.publish-arrow{width:62rpx;height:62rpx;line-height:62rpx;text-align:center;border-radius:50%;background:#146b55;color:#fff;font-size:36rpx}.tabs{display:flex;gap:50rpx;border-bottom:1rpx solid #dce7dd}.tab{padding:0 2rpx 20rpx;color:#9baaa1;font-size:29rpx;font-weight:650}.tab.active{color:#183c35;border-bottom:5rpx solid #1e8164}.section{display:flex;justify-content:space-between;align-items:center;font-size:27rpx;font-weight:700;margin:40rpx 2rpx 18rpx}.section-hint{font-size:21rpx;color:#9aa9a0;font-weight:400}.draft{display:flex;align-items:center;gap:20rpx;padding:24rpx}.draft-icon{width:65rpx;height:65rpx;line-height:65rpx;text-align:center;background:#edf3ed;color:#608c72;border-radius:18rpx;font-size:32rpx}.draft-copy{flex:1;min-width:0}.draft-title{font-size:26rpx;font-weight:700;margin-bottom:8rpx}.arrow{color:#a7b8ac;font-size:40rpx}.all-entry{display:flex;justify-content:space-between;border-bottom:1rpx solid #dfe9df;padding:30rpx 2rpx;color:#648071;font-size:25rpx;font-weight:600}.empty{text-align:center;padding:34rpx 0;color:#99aaa0;font-size:23rpx}.retry{color:#1d795d}
.list-footer { padding: 28rpx 0 36rpx; text-align: center; font-size: 22rpx; }
.guest-group-heading{margin:4rpx 0 18rpx}.guest-group-title-page{color:#173d32;font-size:42rpx;line-height:1.2;font-weight:800}.guest-group-subtitle{margin-top:8rpx;color:#718178;font-size:22rpx;line-height:1.5}
.guest-group-hero{position:relative;overflow:hidden;margin-top:20rpx;padding:26rpx 24rpx;border:1rpx solid #cfe2d6;border-radius:24rpx;background:#e5f0e7}
.guest-group-hero image{position:absolute;top:24rpx;right:20rpx;width:94rpx;height:94rpx}
.guest-group-eyeline{color:#648473;font-size:19rpx;font-weight:750;letter-spacing:2rpx}
.guest-group-title{max-width:75%;margin-top:10rpx;color:#173d32;font-size:29rpx;font-weight:800;line-height:1.35}
.guest-group-copy{max-width:78%;margin-top:10rpx;color:#708278;font-size:21rpx;line-height:1.5}
.guest-group-login{display:flex;align-items:center;justify-content:center;width:100%;height:68rpx;margin:18rpx 0 0;padding:0;border-radius:15rpx;background:#197257;color:#fff;font-size:22rpx;font-weight:700;line-height:1.2;text-align:center}
.guest-group-section-title{margin-top:28rpx;margin-bottom:10rpx}
.guest-group-link{display:flex;align-items:center;justify-content:space-between;gap:18rpx;margin-top:12rpx;padding:20rpx 22rpx;border:1rpx solid #e0e7dd;border-radius:18rpx;background:#fffefa;color:#234638;font-size:23rpx;font-weight:700;line-height:1.4}
.guest-group-link .muted{margin-top:5rpx;font-size:19rpx;font-weight:400;line-height:1.45}
.guest-group-link.locked{background:#fbfcf9}
.guest-group-link>text{flex:none;color:#96a59b;font-size:34rpx;line-height:1}

.recent-heading{display:flex;align-items:center;justify-content:space-between;margin:20rpx 2rpx;color:#93a397;font-size:22rpx;line-height:1.4}
.view-all{display:flex;align-items:center;gap:12rpx;min-height:48rpx;padding-left:24rpx;color:#64846e;font-size:24rpx}.view-all>text{font-size:34rpx;line-height:1}
