<view class="page">
  <view class="page-title">消息与通知</view>
  <view class="message-tabs">
    <view class="message-tab {{activeTab === 'chat' ? 'active' : ''}}" data-tab="chat" bindtap="selectTab">聊天<text wx:if="{{chatUnreadCount}}" class="tab-count">{{chatUnreadCount > 99 ? '99+' : chatUnreadCount}}</text></view>
    <view class="message-tab {{activeTab === 'notification' ? 'active' : ''}}" data-tab="notification" bindtap="selectTab">通知<text wx:if="{{notificationUnreadCount}}" class="tab-count">{{notificationUnreadCount > 99 ? '99+' : notificationUnreadCount}}</text></view>
  </view>

  <block wx:if="{{activeTab === 'chat'}}">
    <view wx:if="{{loadError}}" class="card muted" bindtap="refresh">{{loadError}} · 点击重试</view>
    <view wx:if="{{loading}}" class="empty-state">正在读取聊天…</view>
    <view wx:elif="{{!conversations.length && !loadError}}" class="empty-state"><view class="empty-title">还没有聊天</view><view class="muted">找到合适的约局，和球友聊聊吧。</view></view>
    <view wx:for="{{conversationGroups}}" wx:key="matchId" class="card match-conversation-group">
      <view class="match-group-head">
        <view class="match-group-title">{{item.gameType}} · {{item.venueName || '球房待选择'}}</view>
        <view class="match-group-meta">{{item.timeLabel}}</view>
      </view>
      <view wx:for="{{item.conversations}}" wx:for-item="conversation" wx:key="id" class="conversation-row" data-id="{{conversation.id}}" bindtap="openConversation">
        <image class="conversation-avatar" src="{{conversation.peerAvatar || '/assets/eight-ball.png'}}" mode="aspectFill" />
        <view class="conversation-main"><view class="conversation-name">{{conversation.peerName || '球友'}}<text class="conversation-status">{{conversation.stateLabel}}</text></view><view class="conversation-preview">{{conversation.preview}}</view></view>
        <view class="conversation-tail"><view wx:if="{{conversation.unreadCount}}" class="unread-badge">{{conversation.unreadCount > 99 ? '99+' : conversation.unreadCount}}</view><view class="conversation-arrow">›</view></view>
      </view>
    </view>
  </block>

  <block wx:elif="{{activeTab === 'notification'}}">
    <view wx:if="{{notificationError}}" class="card muted" bindtap="refresh">{{notificationError}} · 点击重试</view>
    <view wx:if="{{loading}}" class="empty-state">正在读取通知…</view>
    <view wx:elif="{{!notifications.length && !notificationError}}" class="empty-state"><view class="empty-title">暂时没有通知</view><view class="muted">约局状态变化和公开展示结束会显示在这里。</view></view>
    <view wx:for="{{notifications}}" wx:key="id" class="card notification-row {{item.unread ? 'notification-unread' : ''}}" data-id="{{item.id}}" data-match-id="{{item.matchId}}" bindtap="openNotification">
      <view class="notification-mark">{{item.type === 'CANCELLED' || item.type === 'PARTICIPANT_LEFT' ? '×' : item.type === 'DISPLAY_ENDED' ? '·' : '✓'}}</view>
      <view class="notification-main"><view class="notification-title">{{item.title}}<text wx:if="{{item.unread}}" class="notification-dot"></text></view><view class="notification-content">{{item.content}}</view><view class="muted">{{item.timeLabel}}</view></view>
      <view class="notification-arrow">›</view>
    </view>
  </block>
</view>
