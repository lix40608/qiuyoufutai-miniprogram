<view class="page">
  <view class="page-title">我的消息</view>
  <view wx:if="{{loadError}}" class="card muted" bindtap="refresh">{{loadError}} · 点击重试</view>
  <view wx:if="{{loading}}" class="empty-state">正在读取聊天…</view>
  <view wx:elif="{{!conversations.length && !loadError}}" class="empty-state"><view class="empty-title">还没有聊天</view><view class="muted">找到合适的约局，和球友聊聊吧。</view></view>
  <view wx:for="{{conversations}}" wx:key="id" class="card conversation-row" data-id="{{item.id}}" bindtap="openConversation">
    <view class="eight-ball"><text>8</text></view>
    <view class="conversation-main"><view class="conversation-name">{{item.peerName || '球友'}}<text class="conversation-status">{{item.stateLabel}}</text></view><view class="muted">{{item.timeLabel}}</view><view class="muted">查看这场约局的聊天 ›</view></view>
  </view>
</view>
