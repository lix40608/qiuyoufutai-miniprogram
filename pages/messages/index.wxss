@import "../../styles/conversation-list.wxss";
.message-tabs { display: flex; align-items: center; gap: 48rpx; padding: 4rpx 4rpx 20rpx; margin-bottom: 8rpx; border-bottom: 1rpx solid #e4e8de; }
.message-tab { position: relative; display: inline-flex; align-items: center; gap: 8rpx; padding: 12rpx 4rpx; color: #718178; font-size: 28rpx; line-height: 36rpx; }
.message-tab.active { color: #173b31; font-weight: 700; }
.message-tab.active::after { position: absolute; right: 4rpx; bottom: -1rpx; left: 4rpx; height: 5rpx; border-radius: 5rpx; background: #197257; content: ''; }
.tab-count { display: inline-flex; align-items: center; justify-content: center; min-width: 32rpx; height: 32rpx; padding: 0 8rpx; border-radius: 999rpx; background: #d65b55; color: #fff; text-align: center; font-size: 18rpx; line-height: 1; font-weight: 700; box-sizing: border-box; }
.notification-row { display: flex; align-items: flex-start; gap: 20rpx; }
.notification-mark { display: flex; align-items: center; justify-content: center; width: 50rpx; height: 50rpx; flex: none; border-radius: 16rpx; }
.notification-mark-confirmed { background: #e7f2eb; color: #24785c; }
.notification-mark-cancelled { background: #faece9; color: #bb6255; }
.notification-mark-ended { background: #f0efea; color: #7d827a; }
.notification-main { flex: 1; min-width: 0; }
.notification-title { color: #173b31; font-size: 28rpx; font-weight: 700; }
.notification-content { margin: 10rpx 0; color: #536b5e; font-size: 24rpx; line-height: 1.5; }
.notification-arrow { color: #9aa69e; font-size: 38rpx; line-height: 44rpx; }
.notification-unread { border-color: #c9ddd0; }
.notification-dot { display: inline-block; width: 12rpx; height: 12rpx; margin-left: 12rpx; border-radius: 50%; background: #d8564e; vertical-align: 3rpx; }
.notification-clock { position: relative; width: 25rpx; height: 25rpx; box-sizing: border-box; border: 2.5rpx solid currentColor; border-radius: 50%; }
.notification-clock::before { position: absolute; left: 9rpx; top: 4rpx; width: 2.5rpx; height: 8rpx; border-radius: 2rpx; background: currentColor; content: ''; }
.notification-clock::after { position: absolute; left: 9rpx; top: 10rpx; width: 7rpx; height: 2.5rpx; border-radius: 2rpx; background: currentColor; content: ''; }

.notification-check { width: 13rpx; height: 23rpx; margin-top: -5rpx; box-sizing: border-box; border-right: 3rpx solid currentColor; border-bottom: 3rpx solid currentColor; transform: rotate(45deg); }
.notification-cross { position: relative; width: 25rpx; height: 25rpx; }
.notification-cross::before,.notification-cross::after { position: absolute; top: 11rpx; left: 1rpx; width: 23rpx; height: 3rpx; border-radius: 2rpx; background: currentColor; content: ''; }
.notification-cross::before { transform: rotate(45deg); }
.notification-cross::after { transform: rotate(-45deg); }
