.message-tabs { display: flex; gap: 48rpx; padding: 4rpx 4rpx 20rpx; margin-bottom: 8rpx; border-bottom: 1rpx solid #e4e8de; }
.message-tab { position: relative; padding: 12rpx 4rpx; color: #718178; font-size: 28rpx; }
.message-tab.active { color: #173b31; font-weight: 700; }
.message-tab.active::after { position: absolute; right: 4rpx; bottom: -1rpx; left: 4rpx; height: 5rpx; border-radius: 5rpx; background: #197257; content: ''; }
.tab-count { display: inline-block; min-width: 28rpx; height: 28rpx; margin-left: 8rpx; padding: 0 7rpx; border-radius: 18rpx; background: #d8564e; color: white; text-align: center; font-size: 18rpx; line-height: 28rpx; box-sizing: border-box; vertical-align: 3rpx; }
.conversation-row { position: relative; display: flex; align-items: center; gap: 24rpx; }
.conversation-main { flex: 1; min-width: 0; }
.conversation-name { margin-bottom: 12rpx; color: #173b31; font-weight: 700; font-size: 30rpx; }
.conversation-status { margin-left: 18rpx; color: #197257; font-size: 22rpx; font-weight: 400; }
.conversation-main .muted { margin-top: 6rpx; }
.conversation-avatar { width: 82rpx; height: 82rpx; flex: none; overflow: hidden; border-radius: 50%; background: #eef1eb; }
.conversation-preview { margin: 8rpx 0; color: #536b5e; font-size: 24rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.unread-badge { position: absolute; top: 16rpx; left: 80rpx; min-width: 30rpx; height: 30rpx; padding: 0 5rpx; border-radius: 20rpx; background: #d8564e; color: white; text-align: center; font-size: 19rpx; line-height: 30rpx; box-sizing: border-box; }
.notification-row { display: flex; align-items: flex-start; gap: 20rpx; }
.notification-mark { width: 46rpx; height: 46rpx; flex: none; border-radius: 50%; background: #e7f0e7; color: #197257; text-align: center; font-size: 30rpx; font-weight: 700; line-height: 46rpx; }
.notification-main { flex: 1; min-width: 0; }
.notification-title { color: #173b31; font-size: 28rpx; font-weight: 700; }
.notification-content { margin: 10rpx 0; color: #536b5e; font-size: 24rpx; line-height: 1.5; }
.notification-arrow { color: #9aa69e; font-size: 38rpx; line-height: 44rpx; }
.notification-unread { border-color: #c9ddd0; }
.notification-unread .notification-mark { background: #197257; color: #fff; }
.notification-dot { display: inline-block; width: 12rpx; height: 12rpx; margin-left: 12rpx; border-radius: 50%; background: #d8564e; vertical-align: 3rpx; }
