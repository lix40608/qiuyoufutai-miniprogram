page {
  --color-ink: #173128;
  --color-muted: #718178;
  --color-green: #197257;
  --color-felt: #eaf0e4;
  --color-paper: #f7f7f2;
  --color-card: #fffefa;
  --color-line: #dfe5da;
  --color-lime: #d8f36a;
  background: var(--color-paper);
  color: var(--color-ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 28rpx;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  padding: 28rpx;
  box-sizing: border-box;
}

.page-title {
  font-size: 42rpx;
  line-height: 1.2;
  font-weight: 700;
}

.muted {
  color: var(--color-muted);
  font-size: 24rpx;
}

.card {
  margin-top: 20rpx;
  padding: 26rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 28rpx;
  background: var(--color-card);
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tag {
  padding: 8rpx 12rpx;
  border-radius: 10rpx;
  background: var(--color-felt);
  color: var(--color-green);
  font-size: 22rpx;
  font-weight: 700;
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 84rpx;
  padding: 0 26rpx;
  border-radius: 22rpx;
  background: var(--color-green);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
}

.page .match-action-row {
  display: flex;
  align-items: stretch;
  gap: 14rpx;
  box-sizing: border-box;
  margin-top: 20rpx;
  padding: 20rpx 24rpx 24rpx;
  border-top: 1rpx solid #f0f4ef;
}

.page .match-action-row .match-action-button {
  display: flex;
  flex: 1 1 0;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-width: 0;
  min-height: 80rpx;
  margin: 0;
  padding: 0 24rpx;
  border: 1rpx solid transparent;
  border-radius: 18rpx;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.2;
  text-align: center;
}

.page .match-action-row .match-action-chat {
  position: relative;
  padding: 0 58rpx;
  border-color: #d7e8dc;
  background: #e7f2eb;
  color: #1b6b52;
}

.page .match-action-row .match-action-cancel {
  border-color: #efdfd9;
  background: #fbf2ef;
  color: #9b6258;
}

.page .match-action-row .match-action-label {
  display: block;
  width: 100%;
  text-align: center;
}

.page .match-action-row .match-action-unread {
  position: absolute;
  top: 50%;
  right: 14rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 9rpx;
  transform: translateY(-50%);
  border: 2rpx solid #fffefa;
  border-radius: 999rpx;
  background: #d65b55;
  box-shadow: 0 3rpx 8rpx rgba(128, 48, 43, .16);
  color: #fff;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1;
  text-align: center;
  white-space: nowrap;
}

.secondary-button {
  color: var(--color-green);
  border: 2rpx solid #b9d6c6;
  background: var(--color-card);
}

.eight-ball-image{width:100%;height:100%;display:block}
